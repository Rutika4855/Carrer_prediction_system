# This is an example .env file for configuring email settings.
# Copy this file to .env and fill in your details.

# Set EMAIL_HOST to enable SMTP email sending. If left empty, emails will print to console.
# Example: EMAIL_HOST=smtp.gmail.com
EMAIL_HOST=

# SMTP port. Common ports are 587 (TLS) or 465 (SSL).
EMAIL_PORT=587

# Use 'True' for TLS, 'False' otherwise. Most modern SMTP servers use TLS.
EMAIL_USE_TLS=True

# Your SMTP username (usually your email address).
EMAIL_HOST_USER=

# Your SMTP password or app-specific password.
EMAIL_HOST_PASSWORD=
